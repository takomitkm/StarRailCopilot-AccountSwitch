# systemd user unit for src's WebUI (gui.py), as deployed on 102 (Debian).
#
# Reference copy: init.py regenerates this file from accounts.yaml
# (`python3 init.py --install-webui-service` overwrites). Keep this file in
# sync with webui_service() when changing fields.
#
# Why it exists: rotate.py assumes gui.py is up - every Alas config instance
# lives in the web UI, and rotation only launches <src_profile>.py against it.
# A fresh machine without this unit cannot reproduce the environment.

[Unit]
Description=StarRailCopilot web UI (Alas launcher)
Documentation=file:///home/user/Desktop/StarRailCopilot/gui.py
After=network.target
PartOf=home-lab.service

[Service]
Type=simple
WorkingDirectory=/home/user/Desktop/StarRailCopilot
Environment=PATH=/home/user/Desktop/StarRailCopilot/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user/Desktop/StarRailCopilot/.venv/bin/python gui.py -p 22367
Restart=on-failure
RestartSec=15
# gui.py respawns itself when it reloads; do not fight it
KillMode=mixed
TimeoutStopSec=20
StandardOutput=append:/home/user/Desktop/StarRailCopilot/gui.log
StandardError=append:/home/user/Desktop/StarRailCopilot/gui.log

[Install]
WantedBy=default.target
